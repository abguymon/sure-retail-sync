# Required: Sure Finance instance URL and API key (Settings -> API Keys in Sure)
SURE_URL=http://sure:3000
SURE_API_KEY=replace-with-sure-api-key

# Required: Shared bearer token protecting the sync server API
# Generate with: openssl rand -hex 32
SYNC_API_TOKEN=replace-with-random-64-char-hex-token

# Categorizer: "jev", "openai" (works with OpenAI/Ollama/OpenRouter/Groq), or "none" (notes-only)
# If omitted, auto-detects based on which API key is set.
CATEGORIZER=none

# Option 1: TypeSafe Jev
# JEV_API_KEY=
# JEV_MODEL=jev-latest

# Option 2: OpenAI-compatible (OpenAI, Ollama, OpenRouter, Groq, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Tuning (optional)
# FALLBACK_CATEGORY=Shopping
# DATE_WINDOW_DAYS=7
# MIN_SPLIT_SHARE=0.10
# MIN_CONFIDENCE=0.5

{
  "manifest_version": 3,
  "name": "Sure Retail Sync",
  "version": "0.1.2",
  "description": "Itemize and categorize Amazon purchases in your self-hosted Sure Finance instance using your signed-in browser session.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sure-retail-sync@abguymon.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "financialAndPaymentInfo",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sure Retail Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

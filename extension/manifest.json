{
  "manifest_version": 3,
  "name": "Sure Retail Sync",
  "version": "0.1.0",
  "description": "Itemize and categorize Amazon purchases in your self-hosted Sure Finance instance using your signed-in browser session.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sure Retail Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
